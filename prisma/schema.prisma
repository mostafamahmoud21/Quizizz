generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instructor {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  quizzes   Quiz[]       // علاقة مع الاختبارات
  courses   Course[]     // علاقة مع الدورات التي يمكن للمدرس إنشاؤها
  questions Question[]    // علاقة مع الأسئلة التي أنشأها المدرس
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  enrollments Enrollment[] // علاقة كثيرة إلى كثيرة بين الطلاب والدورات
  QuizAttempt QuizAttempt[] // علاقة مع محاولات الاختبار
  answers     Answer[]      // علاقة مع الإجابات التي قدمها الطالب
}

enum Role {
  INSTRUCTOR
  STUDENT
}

model Course {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  enrollments Enrollment[] // علاقة كثيرة إلى كثيرة مع الطلاب
  quizzes     Quiz[]       // علاقة مع الاختبارات الخاصة بالدورة
}

model Enrollment {
  id        Int     @id @default(autoincrement())
  studentId Int
  courseId  Int
  student   Student @relation(fields: [studentId], references: [id])
  course    Course  @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  courseId     Int        // Foreign key for Course
  course       Course     @relation(fields: [courseId], references: [id])
  type         Types
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  QuizAttempt QuizAttempt[]  // علاقة مع محاولات الاختبار
  questions   QuizQuestion[]  // علاقة مع الأسئلة في الاختبار
}

model Question {
  id            Int           @id @default(autoincrement())
  text          String
  level         Levels
  correctAnswer String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  choices       Choice[]      // علاقة مع الخيارات
  answers       Answer[]      // علاقة مع الإجابات
  quizzes       QuizQuestion[] // علاقة مع الأسئلة في الاختبارات
  instructorId  Int           // Foreign key to Instructor
  instructor    Instructor    @relation(fields: [instructorId], references: [id]) // علاقة مع نموذج Instructor
}

model QuizQuestion {
  quizId     Int
  questionId Int
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@id([quizId, questionId]) // Composite primary key
}

model Choice {
  id         Int      @id @default(autoincrement())
  text       String
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  quizId    Int
  studentId Int
  score     Int
  dateTaken DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([quizId, studentId]) // Composite unique constraint
}

model Answer {
  id          Int      @id @default(autoincrement())
  text        String
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([questionId, studentId]) // Prevents duplicate answers for the same question by the same student
}

enum Types {
  Quiz
  Final
}

enum Levels {
  Easy
  Medium
  Hard
}
